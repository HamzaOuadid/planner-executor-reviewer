# Copy to .env and fill in ONE of these to use the real LLM client.
# If neither is set, RealLLMClient.from_env() raises a clear error telling
# you to use FakeLLMClient instead (which is what the tests and demo use).

# Anthropic (preferred if both are set)
ANTHROPIC_API_KEY=
PEER_LOOP_ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI (used if ANTHROPIC_API_KEY is not set)
OPENAI_API_KEY=
PEER_LOOP_OPENAI_MODEL=gpt-4o-mini
